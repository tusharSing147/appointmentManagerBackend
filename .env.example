# Copy to server/.env and adjust as needed. Never commit real credentials.

# Port the Express API listens on
PORT=4000

# Allowed browser origin for CORS
CORS_ORIGIN=http://localhost:5173

# Optional. Leave empty to use the JSON-file fallback at server/data/appointments.json.
# Example: mongodb://127.0.0.1:27017/daybook
MONGODB_URI=

# Optional. Overrides the JSON store location.
# DATA_FILE=./data/appointments.json
